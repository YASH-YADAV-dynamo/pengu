# `npm run setup` writes server/.env for you. This file only documents what it can contain. NEVER commit .env,
# and never paste real values into chat, issues or code.

# Leave DATABASE_URL out to use the built-in local database (files in server/.data/).
# Set it to use your own Postgres (Neon, Supabase, RDS, Docker...).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Optional, Neon only: the non-pooled connection string, used just for migrations (the app uses DATABASE_URL, the pooled one).
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs sign-in tokens. 32+ random characters; setup generates one.
# Manual: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PENGU_AUTH_SECRET=""

# Optional: Slack plugin (docs/plugins.md). Both must be set to turn it on.
# SLACK_BOT_TOKEN="<bot user OAuth token>"
# SLACK_SIGNING_SECRET="<signing secret from Basic Information>"

# Optional, for `npm run serve`
# PORT=8787
# HOST=127.0.0.1
# TRUST_PROXY=1   only behind your own reverse proxy that sets x-forwarded-for
